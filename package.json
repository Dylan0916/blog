{
  "name": "dylan-blog",
  "version": "3.0.0",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "start": "bunx --bun astro dev",
    "build": "bunx --bun astro check && bunx --bun astro build && bunx --bun jampack ./dist",
    "build:ci": "bunx --bun astro build && bunx --bun jampack ./dist",
    "preview": "bunx --bun astro preview",
    "sync": "bunx --bun astro sync",
    "astro": "bunx --bun astro",
    "format:check": "oxfmt --check --ignore-path=.gitignore && prettier --check \"src/**/*.astro\"",
    "format": "oxfmt --ignore-path=.gitignore && prettier --write \"src/**/*.astro\"",
    "cz": "cz",
    "prepare": "husky",
    "lint": "oxlint"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.5",
    "astro-seo-schema": "^7.0.0",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.35.0",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@divriots/jampack": "^0.34.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,mdx,json}": [
      "oxfmt --ignore-path=.gitignore --no-error-on-unmatched-pattern"
    ],
    "*.astro": [
      "prettier --write"
    ]
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
