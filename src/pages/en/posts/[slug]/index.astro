---
import { type CollectionEntry } from "astro:content";
import PostPage from "@/components/pages/PostPage.astro";
import { getPostStaticPaths } from "@/utils/getPostStaticPaths";
import type { AdjacentPost } from "@/types";

export const getStaticPaths = getPostStaticPaths;

interface Props {
  post?: CollectionEntry<"posts">;
  prevPost?: AdjacentPost;
  nextPost?: AdjacentPost;
}

const { slug } = Astro.params;
const { post, prevPost, nextPost } = Astro.props as Props;
---

<PostPage slug={slug} post={post} prevPost={prevPost} nextPost={nextPost} />
