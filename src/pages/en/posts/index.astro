---
import { SITE } from "@/config";
import Layout from "@/layouts/BaseLayout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card";
import LinkButton from "@/components/LinkButton.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import getPageNumbers from "@/utils/getPageNumbers";
import { getCollection } from "astro:content";
import { useTranslations } from "@/i18n/ui";
import { localizedPostUrl } from "@/utils/postLocale";

const t = useTranslations("en");

const posts = await getCollection("posts");

const sortedPosts = getSortedPosts(posts);

const totalPages = getPageNumbers(sortedPosts.length);

const paginatedPosts = sortedPosts.slice(0, SITE.postPerPage);

const pageNum = 1;
const isPrevDisabled = true;
const isNextDisabled = pageNum >= totalPages.length;
const disabledButtonClass =
  "pointer-events-none select-none opacity-50 hover:text-skin-base group-hover:fill-skin-base";
const disabledSvgClass = "group-hover:fill-skin-base!";
---

<Layout title={`${t("nav.posts")} | ${SITE.title}`} locale="en" counterpartUrl="/posts/">
  <Header activeNav="posts" locale="en" counterpartUrl="/posts/" />
  <Main pageTitle={t("nav.posts")} pageDesc="All the articles I've posted.">
    <ul>
      {
        paginatedPosts.map(post => (
          <Card href={localizedPostUrl(post, "en")} frontmatter={post.data} locale="en" />
        ))
      }
    </ul>
  </Main>

  {
    totalPages.length > 1 && (
      <nav
        class="mt-auto mb-8 flex justify-center"
        aria-label="Pagination"
      >
        <LinkButton
          disabled={isPrevDisabled}
          href={`/en/posts${pageNum - 1 !== 1 ? "/" + (pageNum - 1) : ""}`}
          className={`mr-4 select-none ${isPrevDisabled ? disabledButtonClass : ""}`}
          ariaLabel="Previous"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class={isPrevDisabled ? disabledSvgClass : ""}
          >
            <path d="M12.707 17.293 8.414 13H18v-2H8.414l4.293-4.293-1.414-1.414L4.586 12l6.707 6.707z" />
          </svg>
          Prev
        </LinkButton>
        <LinkButton
          disabled={isNextDisabled}
          href={`/en/posts/${pageNum + 1}`}
          className={`ml-4 select-none ${isNextDisabled ? disabledButtonClass : ""}`}
          ariaLabel="Next"
        >
          Next
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class={isNextDisabled ? disabledSvgClass : ""}
          >
            <path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z" />
          </svg>
        </LinkButton>
      </nav>
    )
  }
  <Footer noMarginTop={totalPages.length > 1} />
</Layout>
