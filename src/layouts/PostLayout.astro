---
import Layout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime";
import AdjacentPostNav from "@/components/AdjacentPostNav.astro";
import type { AdjacentPost } from "@/types";
import { render, type CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPostJsonLd } from "@/utils/jsonLd";
import { type Locale, useTranslations } from "@/i18n/ui";

export interface Props {
  post: CollectionEntry<"posts">;
  prevPost?: AdjacentPost;
  nextPost?: AdjacentPost;
  locale?: Locale;
  counterpartUrl?: string;
}

const { post, prevPost = null, nextPost = null, locale = "zh-TW", counterpartUrl } = Astro.props;
const t = useTranslations(locale);

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content } = await render(post);

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;
const ogType = "article";
const jsonLd = getPostJsonLd(post);
---

<Layout
  title={title}
  author={author}
  description={description}
  ogImage={ogUrl}
  ogType={ogType}
  canonicalURL={canonicalURL}
  jsonLd={jsonLd}
  locale={locale}
  counterpartUrl={counterpartUrl}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={new Date(pubDatetime).toISOString()} />
    {modDatetime && (
      <meta property="article:modified_time" content={new Date(modDatetime).toISOString()} />
    )}
    {tags && tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>
  <Header locale={locale} counterpartUrl={counterpartUrl} />
  <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
    <button
      class="focus-outline mb-2 mt-8 flex hover:opacity-75"
      onclick="history.back()"
    >
      <svg xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
        ></path>
      </svg><span>{t("post.goBack")}</span>
    </button>
  </div>
  <main
    id="main-content"
    class="mx-auto w-full max-w-3xl px-4 pb-12"
  >
    <h1
      transition:name={slugifyStr(title)}
      class="text-2xl font-semibold text-skin-accent"
    >{title}</h1>
    <Datetime datetime={pubDatetime} size="lg" className="my-2" />
    <article id="article" role="article" class="prose mx-auto mt-8 max-w-3xl">
      <Content />
    </article>

    <ul class="my-8">
      {tags.map(tag => <Tag name={slugifyStr(tag)} locale={locale} />)}
    </ul>

    <AdjacentPostNav prevPost={prevPost} nextPost={nextPost} />

    <div class="flex justify-end">
      <button
        id="back-to-top"
        class="focus-outline whitespace-nowrap hover:opacity-75"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rotate-90">
          <path
            d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
          ></path>
        </svg>
        <span>{t("post.backToTop")}</span>
      </button>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  // Wire the "Back to Top" button on every navigation. Bound via
  // astro:page-load (fires on first load AND after each View Transitions
  // swap) so the listener survives client-side navigation — e.g. switching
  // language or moving between posts without a full reload.
  document.addEventListener("astro:page-load", () => {
    document.querySelector("#back-to-top")?.addEventListener("click", () => {
      document.body.scrollTop = 0; // For Safari
      document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    });
  });
</script>
