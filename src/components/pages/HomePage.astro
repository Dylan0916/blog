---
import { getCollection } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Hr from "@/components/Hr.astro";
import Card from "@/components/Card";
import Socials from "@/components/Socials.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE, SOCIALS } from "@/config";
import { useTranslations } from "@/i18n/ui";
import { resolveLocale } from "@/utils/getLocale";
import { localizedPostUrl, localizedCardData } from "@/utils/postLocale";

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const prefix = locale === "en" ? "/en" : "";

const posts = await getCollection("posts");

const sortedPosts = getSortedPosts(posts);

const socialCount = SOCIALS.filter(social => social.active).length;
const showRss = false;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero" class="pt-8 pb-6">
      {
        showRss && (
          <a
            target="_blank"
            href="/rss.xml"
            class="mb-6"
            aria-label="rss feed"
            title="RSS Feed"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="fill-skin-accent mb-2 h-6 w-6 scale-110 sm:mb-3 sm:scale-125"
            >
              <>
                <path d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z" />
                <path d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z" />
                <circle cx="6" cy="18" r="2" />
              </>
            </svg>
          </a>
        )
      }

      <p class="my-2">{t("home.bio")}</p>
      {
        // only display if at least one social link is enabled
        socialCount > 0 && (
          <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
            <div class="mr-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    <section id="recent-posts" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">
        {t("home.recentPosts")}
      </h2>
      <ul>
        {
          sortedPosts
            .filter((_, index: number) => index < SITE.recentPostNum)
            .filter(({ data }) => !data.featured)
            .map(post => (
              <Card
                href={localizedPostUrl(post, locale)}
                frontmatter={localizedCardData(post, posts, locale)}
                secHeading={false}
                locale={locale}
              />
            ))
        }
      </ul>
      <div class="my-8 text-center">
        <LinkButton href={`${prefix}/posts`}>
          {t("home.allPosts")}
          <svg xmlns="http://www.w3.org/2000/svg"
            ><path
              d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
            ></path>
          </svg>
        </LinkButton>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
