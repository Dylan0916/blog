---
import { useTranslations } from "@/i18n/ui";
import { resolveLocale, getCounterpartUrl } from "@/utils/getLocale";

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const label = locale === "en" ? t("langToggle.toZh") : t("langToggle.toEn");
const counterpartUrl = getCounterpartUrl(Astro.url.pathname);
---

<a
  href={counterpartUrl}
  class="hover:text-skin-accent text-sm"
  aria-label="Switch language"
>
  {label}
</a>
