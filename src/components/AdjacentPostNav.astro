---
import { useTranslations, type Locale } from "@/i18n/ui";
import type { AdjacentPost } from "@/types";

export interface Props {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
  locale?: Locale;
}

const { prevPost, nextPost, locale = "zh-TW" } = Astro.props;
const t = useTranslations(locale);

const hasNav = Boolean(prevPost) || Boolean(nextPost);
---

{
  hasNav && (
    <nav
      class="my-8 grid grid-cols-1 gap-4 sm:grid-cols-2"
      aria-label="文章導覽"
    >
      {prevPost ? (
        <a
          href={prevPost.url}
          class="flex flex-col gap-1 hover:opacity-75"
        >
          <span class="text-sm">{`← ${t("post.prev")}`}</span>
          <span class="font-medium text-skin-accent">{prevPost.title}</span>
        </a>
      ) : (
        <span />
      )}
      {nextPost ? (
        <a
          href={nextPost.url}
          class="flex flex-col gap-1 hover:opacity-75 sm:col-start-2 sm:text-right"
        >
          <span class="text-sm">{`${t("post.next")} →`}</span>
          <span class="font-medium text-skin-accent">{nextPost.title}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
