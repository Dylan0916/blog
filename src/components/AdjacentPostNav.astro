---
import { useTranslations } from "@/i18n/ui";
import { resolveLocale } from "@/utils/getLocale";
import type { AdjacentPost } from "@/types";

export interface Props {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
}

const { prevPost, nextPost } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const prefix = locale === "en" ? "/en" : "";

const hasNav = Boolean(prevPost) || Boolean(nextPost);
---

{
  hasNav && (
    <nav
      class="my-8 grid grid-cols-1 gap-4 sm:grid-cols-2"
      aria-label="文章導覽"
    >
      {prevPost ? (
        <a
          href={`${prefix}/posts/${prevPost.slug}/`}
          class="flex flex-col gap-1 hover:opacity-75"
        >
          <span class="text-sm">{`← ${t("post.prev")}`}</span>
          <span class="text-skin-accent font-medium">{prevPost.title}</span>
        </a>
      ) : (
        <span />
      )}
      {nextPost ? (
        <a
          href={`${prefix}/posts/${nextPost.slug}/`}
          class="flex flex-col gap-1 hover:opacity-75 sm:col-start-2 sm:text-right"
        >
          <span class="text-sm">{`${t("post.next")} →`}</span>
          <span class="text-skin-accent font-medium">{nextPost.title}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
