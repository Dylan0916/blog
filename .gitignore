# build output
dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# ignore .astro directory
.astro

# Jampack cache is committed on purpose: Cloudflare Pages does a fresh clone
# each build and offers no custom build-cache dir, so committing the cache
# keeps `jampack` warm (~14s saved). It is content-hashed + self-invalidating.

# OG-image runtime cache — local only (regenerated cheaply, not worth tracking)
.cache/

# yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
